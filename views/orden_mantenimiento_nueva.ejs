<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<div class="main-content">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="m-0 text-secondary fw-bold">
            <i class="fa-solid fa-calendar-week me-2 text-primary"></i>Nueva Orden - Mantenimiento Planificado
        </h4>
        <a href="/dashboard" class="btn btn-secondary rounded-pill px-4">
            <i class="fa-solid fa-arrow-left me-2"></i>Volver
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form action="/ordenes/mantenimiento/guardar" method="POST">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Técnico Asignado</label>
                        <select name="tecnico_asignado" class="form-select" required>
                            <option value="">Seleccione técnico...</option>
                            <% tecnicos.forEach(t => { %>
                                <option value="<%= t.id_usuarios %>"><%= t.nombre %></option>
                            <% }) %>
                        </select>
                    </div>
                    
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Fecha de Mantenimiento</label>
                        <input type="date" name="fecha_apertura" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>" required>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Equipos a atender</label>
                    <select name="equipos[]" id="selectEquipos" class="form-select" multiple size="5" required>
                        <% equipos.forEach(e => { %>
                            <option value="<%= e.id_equipo %>">
                                <%= e.codigo_informatico %> - <%= e.marca_modelo %> | <%= e.nombre_completo || 'Sin asignar' %>
                            </option>
                        <% }) %>
                    </select>
                    <small class="text-muted">Presione Ctrl para seleccionar múltiples equipos</small>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Trabajo Realizado / Mantenimiento</label>
                    <textarea name="trabajo_realizado" class="form-control" rows="4" placeholder="Describa las tareas de mantenimiento realizadas..." required></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Observaciones Adicionales</label>
                    <textarea name="observaciones" class="form-control" rows="2" placeholder="Notas adicionales..."></textarea>
                </div>

                <div class="text-end">
                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                        <i class="fa-solid fa-save me-2"></i>Registrar Orden de Mantenimiento
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('partials/footer') %>