<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<div class="main-content p-4">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold text-dark">⚙️ Catálogo de Equipos</h3>
                <p class="text-muted">Configure las marcas y modelos permitidos en el inventario.</p>
            </div>
            <%- include('partials/user-info') %>
        </div>

        <div class="row g-4">
            <div class="col-xl-4 col-lg-5">
                <div class="modern-card shadow-sm bg-white p-4 mb-4" style="border-radius: 15px;">
                    <h5 class="fw-bold mb-3"><i class="fas fa-tag text-primary"></i> 1. Nueva Marca</h5>
                    <form action="/catalogo/marcas/guardar" method="POST">
                        <div class="input-group">
                            <input type="text" name="nombre_marca" class="form-control text-uppercase" placeholder="EJ: DELL, HP" required oninput="this.value = this.value.toUpperCase()">
                            <button type="submit" class="btn btn-primary">Añadir</button>
                        </div>
                    </form>
                </div>

                <div class="modern-card shadow-sm bg-white p-4" style="border-radius: 15px;">
                    <h5 class="fw-bold mb-3"><i class="fas fa-microchip text-success"></i> 2. Vincular Modelo</h5>
                    <form action="/catalogo/modelos/guardar" method="POST">
                        <div class="mb-3">
                            <label class="small fw-bold">Tipo de Equipo:</label>
                            <select name="id_tipo" class="form-select" required>
                                <option value="">Seleccione tipo...</option>
                                <% tipos.forEach(t => { %>
                                    <option value="<%= t.id_tipo %>"><%= t.nombre_tipo %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="small fw-bold">Marca:</label>
                            <select name="id_marca" class="form-select" required>
                                <option value="">Seleccione marca...</option>
                                <% marcas.forEach(m => { %>
                                    <option value="<%= m.id_marca %>"><%= m.nombre_marca %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="small fw-bold">Nombre del Modelo:</label>
                            <input type="text" name="nombre_modelo" class="form-control text-uppercase" placeholder="EJ: OPTIPLEX 7050" required oninput="this.value = this.value.toUpperCase()">
                        </div>
                        <button type="submit" class="btn btn-success w-100 rounded-pill">Vincular al Catálogo</button>
                    </form>
                </div>
            </div>

            <div class="col-xl-8 col-lg-7">
                <div class="modern-card bg-white h-100 shadow-sm p-0" style="border-radius: 15px; overflow: hidden;">
                    <div class="bg-light p-3 border-bottom">
                        <h6 class="m-0 fw-bold text-dark text-uppercase">Modelos configurados en el sistema</h6>
                    </div>
                    <div class="table-responsive" style="max-height: 500px;">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-white sticky-top">
                                <tr class="small">
                                    <th>TIPO</th>
                                    <th>MARCA</th>
                                    <th>MODELO</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% modelos.forEach(mod => { %>
                                    <tr>
                                        <td><span class="badge bg-light text-dark border"><%= mod.nombre_tipo %></span></td>
                                        <td class="fw-bold"><%= mod.nombre_marca %></td>
                                        <td><%= mod.nombre_modelo %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div><%- include('partials/footer') %>
