<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<style>
    :root {
        --glass-bg: rgba(255, 255, 255, 0.9);
        --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .main-content {
        padding-top: 20px;
        transition: all 0.3s;
    }

    .modern-card {
        background: var(--glass-bg);
        backdrop-filter: blur(10px);
        border-radius: 15px;
        border: none;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        overflow: hidden;
        margin-bottom: 1.5rem;
    }

    .card-header-custom {
        background: var(--primary-gradient);
        color: white;
        padding: 15px 20px;
        font-weight: 600;
        border: none;
    }

    .form-label-custom {
        font-size: 0.8rem;
        font-weight: 700;
        color: #555;
        margin-bottom: 5px;
    }

    .input-modern {
        border-radius: 10px;
        border: 1px solid #e0e0e0;
        padding: 10px;
        font-size: 0.9rem;
    }

    .input-modern:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }

    .table-modern thead th {
        background-color: #f8f9fa;
        color: #333;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.75rem;
        border: none;
        padding: 12px 8px;
    }

    .table-modern tbody td {
        padding: 12px 8px;
        vertical-align: middle;
    }

    .info-box-mini {
        background: #f0f4ff;
        border-left: 4px solid #667eea;
        border-radius: 8px;
        padding: 10px;
        margin-top: 10px;
        font-size: 0.85rem;
    }

    .btn-accion {
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 0.7rem;
        margin: 0 2px;
    }
    
    /* Corrección para Select2 */
    .select2-container--bootstrap-5 .select2-selection {
        min-height: 38px;
        border-radius: 10px;
    }
</style>

<div class="main-content">
    <header class="top-nav d-flex justify-content-between align-items-center mb-4">
        <h4 class="m-0 text-secondary fw-bold">🛠️ Recepción Técnica</h4>
        <p class="text-muted small mb-0">Gestión de ingresos y asignación de Técnicos</p>
        <div class="user-profile bg-white p-2 rounded-pill shadow-sm">
            <%- include('partials/user-info') %>
        </div>
    </header>

    <% if (messages && messages.success) { %>
        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
            <i class="fa-solid fa-check-circle me-2"></i> <%= messages.success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <% if (messages && messages.error) { %>
        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
            <i class="fa-solid fa-exclamation-triangle me-2"></i> <%= messages.error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <!-- FORMULARIO ARRIBA -->
    <div class="modern-card mb-4">
        <div class="card-header-custom">
            <i class="fa-solid fa-file-invoice me-2"></i>Nueva Orden de Servicio
        </div>
        <div class="card-body p-4">
            <form action="/taller/recepcion/guardar" method="POST">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label-custom">Código del Equipo</label>
                        <select name="id_equipo" id="select-equipo" class="form-select input-modern shadow-sm" required style="width: 100%;">
                            <option value="">🔍 Buscar equipo por código...</option>
                            <% if (listaEquipos && listaEquipos.length > 0) { %>
                                <% listaEquipos.forEach(eq => { %>
                                    <option value="<%= eq.id_equipo %>" 
                                            data-inv="<%= eq.codigo_inventario || '' %>" 
                                            data-area="<%= eq.area_departamento || '' %>"
                                            data-serie="<%= eq.serie || '' %>">
                                        <%= eq.codigo_informatico %> - <%= eq.marca_modelo %> (Serie: <%= eq.serie %>)
                                    </option>
                                <% }) %>
                            <% } %>
                        </select>
                        <div id="info-equipo-mini" class="info-box-mini" style="display: none;">
                            <strong>Inv:</strong> <span id="v-inv"></span> | 
                            <strong>Área:</strong> <span id="v-area"></span> |
                            <strong>Serie:</strong> <span id="v-serie"></span>
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label-custom text-primary">Técnico Asignado</label>
                        <select name="tecnico_asignado" id="select-tecnico" class="form-select input-modern border-primary shadow-sm" required style="width: 100%;">
                            <option value="">👨‍🔧 Seleccione el técnico que atenderá...</option>
                            <% if (listaTecnicos && listaTecnicos.length > 0) { %>
                                <% listaTecnicos.forEach(tec => { %>
                                    <option value="<%= tec.id_usuarios %>">
                                        👤 <%= tec.nombre %>
                                    </option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label-custom">Entrega</label>
                        <input type="text" name="quien_entrega" class="form-control input-modern" placeholder="Nombre" required>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label-custom">Accesorios</label>
                        <input type="text" name="accesorios" class="form-control input-modern" placeholder="Cargador, etc.">
                    </div>

                    <div class="col-md-8 mb-3">
                        <label class="form-label-custom text-danger">DESCRIPCIÓN DE FALLA</label>
                        <textarea name="falla_reportada" class="form-control input-modern" rows="2" placeholder="Síntomas del equipo..." required></textarea>
                    </div>

                    <div class="col-12 text-end">
                        <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow">
                            <i class="fa-solid fa-circle-check me-2"></i>Registrar Ingreso
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- BUSCADOR Y TABLA -->
    <div class="modern-card">
        <div class="card-body p-0">
            <div class="p-3 border-bottom bg-light d-flex justify-content-between align-items-center">
                <h6 class="m-0 fw-bold"><i class="fa-solid fa-list me-2"></i>Órdenes de Servicio</h6>
                <div class="input-group" style="width: 300px;">
                    <span class="input-group-text bg-white border-end-0 rounded-start-pill">
                        <i class="fa-solid fa-magnifying-glass text-muted"></i>
                    </span>
                    <input type="text" id="busqueda-recepcion" class="form-control border-start-0 rounded-end-pill shadow-none" placeholder="Buscar...">
                </div>
            </div>

            <div class="table-responsive" style="max-height: 450px; overflow-y: auto;">
                <table class="table table-hover align-middle table-modern mb-0">
                    <thead class="sticky-top bg-light">
                        <tr>
                            <th class="ps-4">Fecha</th>
                            <th># ID</th>
                            <th>Equipo / Modelo</th>
                            <th>Técnico</th>
                            <th>Entrega</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (ingresos && ingresos.length > 0) { %>
                            <% ingresos.forEach(ing => { %>
                                <tr class="fila-orden">
                                    <td class="ps-4 small text-muted"><%= new Date(ing.fecha_ingreso).toLocaleDateString() %> </td>
                                    <td class="text-center fw-bold text-primary">#<%= ing.id_recepcion %></td>
                                    <td>
                                        <div class="fw-bold text-dark"><%= ing.codigo_informatico %></div>
                                        <div class="text-muted" style="font-size: 0.7rem;"><%= ing.marca_modelo %></div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-primary border px-2 py-1">
                                            <i class="fa-solid fa-user-gear me-1"></i> <%= ing.nombre_tecnico || 'Pendiente' %>
                                        </span>
                                    </td>
                                    <td class="small"><%= ing.quien_entrega || 'N/E' %></td>
                                    <td class="text-center">
                                        <%
                                            let estadoClass = 'bg-warning text-dark';
                                            if (ing.estado_reparacion === 'Entregado') {
                                                estadoClass = 'bg-success';
                                            } else if (ing.estado_reparacion === 'Reparado') {
                                                estadoClass = 'bg-info';
                                            }
                                        %>
                                        <span class="badge rounded-pill <%= estadoClass %> px-3">
                                            <%= ing.estado_reparacion %>
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <!-- Botón Imprimir Orden -->
                                        <button class="btn btn-sm btn-secondary btn-accion btn-imprimir" title="Imprimir Orden" data-id="<%= ing.id_recepcion %>">
                                            <i class="fa-solid fa-print"></i>
                                        </button>
                                        <a href="/taller/reparacion/<%= ing.id_recepcion %>/repuestos" class="btn btn-sm btn-primary btn-accion" title="Reparar">
                                            <i class="fa-solid fa-tools"></i>
                                        </a>
                                        <button class="btn btn-sm btn-success btn-accion btn-entregar" 
                                                title="Entregar" 
                                                data-bs-toggle="modal" 
                                                data-bs-target="#modalEntregar" 
                                                data-id="<%= ing.id_recepcion %>" 
                                                data-equipo="<%= ing.codigo_informatico %>">
                                            <i class="fa-solid fa-check-circle"></i>
                                        </button>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <i class="fa-solid fa-inbox fa-2x mb-2 d-block"></i>
                                    No hay órdenes de servicio registradas
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Librerías -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<script>
    // ============================================
    // 1. FUNCIÓN PARA ACTUALIZAR INFO DEL EQUIPO
    // ============================================
    function actualizarInfoEquipo() {
        const select = document.getElementById('select-equipo');
        if (!select) return;
        
        const selectedOption = select.options[select.selectedIndex];
        const info = document.getElementById('info-equipo-mini');
        
        if (selectedOption && selectedOption.value !== "") {
            const inv = selectedOption.getAttribute('data-inv') || 'N/A';
            const area = selectedOption.getAttribute('data-area') || 'N/A';
            const serie = selectedOption.getAttribute('data-serie') || 'N/A';
            
            document.getElementById('v-inv').textContent = inv;
            document.getElementById('v-area').textContent = area;
            document.getElementById('v-serie').textContent = serie;
            
            info.style.display = 'block';
        } else {
            info.style.display = 'none';
        }
    }

    // ============================================
    // 2. INICIALIZAR SELECT2
    // ============================================
    $(document).ready(function() {
        // Select2 para equipos
        $('#select-equipo').select2({
            theme: 'bootstrap-5',
            placeholder: '🔍 Buscar equipo...',
            allowClear: true,
            width: '100%'
        });
        
        // Select2 para técnicos
        $('#select-tecnico').select2({
            theme: 'bootstrap-5',
            placeholder: '👨‍🔧 Seleccione técnico...',
            allowClear: true,
            width: '100%'
        });
        
        // Evento change para equipos
        $('#select-equipo').on('change', function() {
            setTimeout(actualizarInfoEquipo, 50);
        });
        
        // Si hay valor seleccionado, mostrar info
        if ($('#select-equipo').val()) {
            actualizarInfoEquipo();
        }
    });

    // ============================================
    // 3. BUSCADOR DE TABLA
    // ============================================
    const buscador = document.getElementById('busqueda-recepcion');
    if (buscador) {
        buscador.addEventListener('keyup', function() {
            const q = this.value.toLowerCase();
            document.querySelectorAll('.fila-orden').forEach(row => {
                if (row.innerText.toLowerCase().includes(q)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });
    }
    
    // ============================================
    // 4. ENTREGAR EQUIPO
    // ============================================
    document.addEventListener('click', function(e) {
        const btn = e.target.closest('.btn-entregar');
        if (btn) {
            e.preventDefault();
            const id = btn.getAttribute('data-id');
            if (id && confirm('¿Marcar este equipo como ENTREGADO?')) {
                window.location.href = '/taller/recepcion/entregar/' + id;
            }
        }
    });

    // 5. IMPRIMIR ORDEN DE SERVICIO
    // ============================================
    // Usamos delegación de eventos para los botones de imprimir
    document.addEventListener('click', function(e) {
        const btn = e.target.closest('.btn-imprimir');
        if (btn) {
            e.preventDefault();
            const id = btn.getAttribute('data-id');
            if (id) {
                // Abrir en nueva ventana para imprimir
                window.open('/taller/recepcion/imprimir/' + id, '_blank', 'width=800,height=600');
            }
        }
    });


</script>

<!-- MODAL DE ENTREGA DE EQUIPO -->
<div class="modal fade" id="modalEntregar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="border-radius: 20px;">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">
                    <i class="fa-solid fa-handshake me-2"></i>Entrega de Equipo
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/taller/recepcion/entregar" method="POST" id="formEntrega">
                <div class="modal-body">
                    <input type="hidden" name="id_recepcion" id="entrega_id_recepcion">
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Equipo</label>
                            <input type="text" id="entrega_equipo" class="form-control" readonly disabled>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Fecha de Entrega</label>
                            <input type="datetime-local" name="fecha_entrega" class="form-control" value="<%= new Date().toISOString().slice(0,16) %>" required>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Técnico que Entrega</label>
                            <input type="text" name="tecnico_entrega" class="form-control" value="<%= nombre %>" readonly required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Persona que Retira</label>
                            <input type="text" name="persona_retira" class="form-control" placeholder="Nombre completo" required>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Cédula / Documento</label>
                            <input type="text" name="documento_retira" class="form-control" placeholder="Número de cédula o documento">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Teléfono</label>
                            <input type="text" name="telefono_retira" class="form-control" placeholder="Número de contacto">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Observaciones de Entrega</label>
                        <textarea name="observaciones_entrega" class="form-control" rows="2" placeholder="Estado del equipo al momento de entrega, observaciones adicionales..."></textarea>
                    </div>

                    <div class="form-check mb-3">
                        <input type="checkbox" class="form-check-input" id="imprimir_seguridad" name="imprimir_seguridad" value="1">
                        <label class="form-check-label" for="imprimir_seguridad">
                            <i class="fa-solid fa-shield-alt me-1"></i> Imprimir copia para Seguridad
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success rounded-pill">
                        <i class="fa-solid fa-check-circle me-2"></i>Confirmar Entrega
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Pasar datos al modal
    document.querySelectorAll('.btn-entregar').forEach(btn => {
        btn.addEventListener('click', function() {
            const id = this.getAttribute('data-id');
            const equipo = this.getAttribute('data-equipo');
        
            console.log("ID Recepción:", id);  // Depuración
            console.log("Equipo:", equipo);    // Depuración
        
           document.getElementById('entrega_id_recepcion').value = id;
           document.getElementById('entrega_equipo').value = equipo;
        });
    });
</script>

<%- include('partials/footer') %>
