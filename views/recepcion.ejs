<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<style>
    :root {
        --glass-bg: rgba(255, 255, 255, 0.9);
        --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    /* Contenedor principal*/
    .main-content {
        padding-top: 20px;
        transition: all 0.3s;
    }

    .modern-card {
        background: var(--glass-bg);
        backdrop-filter: blur(10px);
        border-radius: 15px;
        border: none;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        overflow: hidden;
        margin-bottom: 1.5rem;
    }

    .card-header-custom {
        background: var(--primary-gradient);
        color: white;
        padding: 15px 20px;
        font-weight: 600;
        border: none;
    }

    .form-label-custom {
        font-size: 0.8rem;
        font-weight: 700;
        color: #555;
        margin-bottom: 5px;
    }

    .input-modern {
        border-radius: 10px;
        border: 1px solid #e0e0e0;
        padding: 10px;
        font-size: 0.9rem;
    }

    .input-modern:focus {
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }

    /* Estilo de la tabla */
    .table-modern thead th {
        background-color: #f8f9fa;
        color: #333;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 0.75rem;
        border: none;
    }

    .info-box-mini {
        background: #f0f4ff;
        border-left: 4px solid #667eea;
        border-radius: 8px;
        padding: 10px;
        margin-top: 10px;
        font-size: 0.85rem;
    }
</style>


<div class="main-content">
    <header class="top-nav d-flex justify-content-between align-items-center mb-4">
        <h4 class="m-0 text-secondary fw-bold">🛠️ Recepción Técnica</h4>
        <p class="text-muted small mb-0">Gestión de ingresos y asignación de Técnicos</p>
        <div class="user-profile bg-white p-2 rounded-pill shadow-sm">
            <%- include('partials/user-info') %>
        </div>
    </header>


        <div class="row g-4">
            <div class="col-xl-4 col-lg-5">
                <div class="modern-card">
                    <div class="card-header-custom">
                        <i class="fa-solid fa-file-invoice me-2"></i>Nueva Orden de Servicio
                    </div>
                    <div class="card-body p-4">
                        <form action="/taller/recepcion/guardar" method="POST">
                            
                            <div class="mb-3">
                                <label class="form-label-custom">Código del Equipo</label>
                                <select name="id_equipo" id="select-equipo" class="form-select input-modern shadow-sm" required>
                                    <option value="">Seleccione el equipo...</option>
                                    <% listaEquipos.forEach(eq => { %>
                                        <option value="<%= eq.id_equipo %>" data-inv="<%= eq.codigo_inventario %>" data-area="<%= eq.area_departamento %>">
                                            <%= eq.codigo_informatico %> - <%= eq.marca_modelo %>
                                        </option>
                                    <% }) %>
                                </select>
                                <div id="info-equipo-mini" class="info-box-mini" style="display: none;">
                                    <strong>Inv:</strong> <span id="v-inv"></span> | <strong>Área:</strong> <span id="v-area"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                               <label class="form-label-custom text-primary">Técnico Asignado</label>
                               <select name="tecnico_asignado" class="form-select input-modern border-primary shadow-sm" required>
                                   <option value="">¿Quién atenderá el caso?</option>
                                   <% listaTecnicos.forEach(tec => { %>
                                       <option value="<%= tec.id_usuarios %>"><%= tec.nombre %></option>
                                   <% }) %>
                               </select>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label-custom">Entrega</label>
                                    <input type="text" name="quien_entrega" class="form-control input-modern" placeholder="Nombre" required>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label-custom">Accesorios</label>
                                    <input type="text" name="accesorios" class="form-control input-modern" placeholder="Cargador, etc.">
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label-custom text-danger">DESCRIPCIÓN DE FALLA</label>
                                <textarea name="falla_reportada" class="form-control input-modern" rows="3" placeholder="Síntomas del equipo..." required></textarea>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 fw-bold shadow">
                                <i class="fa-solid fa-circle-check me-2"></i>Registrar Ingreso
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-xl-8 col-lg-7">
                <div class="modern-card">
                    <div class="card-body p-0">
                        <div class="p-3 border-bottom bg-light">
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 rounded-start-pill">
                                    <i class="fa-solid fa-magnifying-glass text-muted"></i>
                                </span>
                                <input type="text" id="busqueda-recepcion" class="form-control border-start-0 rounded-end-pill shadow-none" placeholder="Buscar orden por técnico o código...">
                            </div>
                        </div>

                        <div class="table-responsive" style="max-height: 550px;">
                            <table class="table table-hover align-middle table-modern mb-0">
                                <thead class="sticky-top">
                                    <tr>
                                        <th class="ps-4">Fecha</th>
                                        <th>Equipo / Modelo</th>
                                        <th>Responsable</th>
                                        <th class="text-center">Estado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (ingresos.length > 0) { %>
                                        <% ingresos.forEach(ing => { %>
                                            <tr class="fila-orden">
                                                <td class="ps-4 small text-muted"><%= new Date(ing.fecha_ingreso).toLocaleDateString() %></td>
                                                <td>
                                                    <div class="fw-bold text-dark"><%= ing.codigo_informatico %></div>
                                                    <div class="text-muted" style="font-size: 0.7rem;"><%= ing.marca_modelo %></div>
                                                </td>
                                                <td>
                                                    <span class="badge bg-light text-primary border px-2 py-1">
                                                        <i class="fa-solid fa-user-gear me-1"></i> <%= ing.nombre_tecnico || 'Pendiente' %>
                                                    </span>
                                                </td>
                                                <td class="text-center">
                                                    <% let bClass = (ing.estado_reparacion === 'Entregado') ? 'bg-success' : 'bg-warning text-dark'; %>
                                                    <span class="badge rounded-pill <%= bClass %> px-3">
                                                        <%= ing.estado_reparacion %>
                                                    </span>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // La lógica del select
    document.getElementById('select-equipo').addEventListener('change', function() {
        const sel = this.options[this.selectedIndex];
        const info = document.getElementById('info-equipo-mini');
        if (this.value !== "") {
            document.getElementById('v-inv').textContent = sel.getAttribute('data-inv');
            document.getElementById('v-area').textContent = sel.getAttribute('data-area');
            info.style.display = 'block';
        } else { info.style.display = 'none'; }
    });

    // Buscador instantáneo
    document.getElementById('busqueda-recepcion').addEventListener('keyup', function() {
        const q = this.value.toLowerCase();
        document.querySelectorAll('.fila-orden').forEach(row => {
            row.style.display = row.innerText.toLowerCase().includes(q) ? '' : 'none';
        });
    });
</script><%- include('partials/footer') %>
