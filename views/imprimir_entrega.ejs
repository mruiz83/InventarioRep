<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Comprobante de Entrega - ENACAL</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Courier New', monospace;
            font-size: 12px;
            padding: 20px;
            background: white;
        }
        .entrega-container {
            max-width: 800px;
            margin: 0 auto;
            border: 1px solid #ccc;
            padding: 20px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }
        .header-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 2px solid #003366;
        }
        .logo-area {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .logo-enacal {
            width: 60px;
            height: 60px;
        }
        .logo-enacal img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }
        .taller-icon {
            text-align: right;
        }
        .taller-icon i {
            font-size: 40px;
            color: #667eea;
        }
        .title {
            text-align: center;
            margin: 20px 0;
        }
        .title h2 {
            font-size: 16px;
            text-transform: uppercase;
        }
        .title p {
            font-size: 12px;
            color: #666;
        }
        .info-section {
            margin-bottom: 15px;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
        }
        .info-row {
            margin-bottom: 5px;
        }
        .label {
            font-weight: bold;
            display: inline-block;
            width: 130px;
        }
        .firma {
            margin-top: 40px;
            display: flex;
            justify-content: space-between;
        }
        .firma-linea {
            text-align: center;
            width: 45%;
        }
        .firma-linea hr {
            margin-top: 30px;
            width: 100%;
        }
        .seguridad-nota {
            margin-top: 20px;
            padding: 10px;
            background: #fff3cd;
            border: 1px dashed #ffc107;
            text-align: center;
            font-size: 11px;
        }
        @media print {
            body { padding: 0; margin: 0; }
            .no-print { display: none; }
            button { display: none; }
        }
        button {
            margin-top: 20px;
            padding: 10px 20px;
            background: #007bff;
            color: white;
            border: none;
            cursor: pointer;
            border-radius: 5px;
        }
        .btn-cerrar {
            background: #6c757d;
            margin-left: 10px;
        }
    </style>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
<div class="entrega-container">
    <!-- HEADER -->
    <div class="header-top">
        <div class="logo-area">
            <div class="logo-enacal">
                <img src="/img/Logo_ENACAL_2.png" alt="Logo ENACAL">
            </div>
            <div>
                <h3>ENACAL</h3>
                <small>Ente Nicaragüense de Acueductos y Alcantarillados</small>
            </div>
        </div>
        <div class="taller-icon">
            <i class="fa-solid fa-screwdriver-wrench"></i>
            <p>TALLER DE SOPORTE TÉCNICO</p>
        </div>
    </div>

    <div class="title">
        <h2>COMPROBANTE DE ENTREGA DE EQUIPO</h2>
        <% if (tipo === 'seguridad') { %>
            <p><strong>🔒 PARA ENTREGA AL PERSONAL DE SEGURIDAD 🔒</strong></p>
        <% } else { %>
            <p>Archivo del Taller</p>
        <% } %>
    </div>

    <div class="info-section">
        <h5><i class="fa-solid fa-info-circle"></i> DATOS DE LA ENTREGA</h5>
        <div class="info-row"><span class="label">N° Recepción:</span> <%= recepcion.id_recepcion %></div>
        <div class="info-row"><span class="label">Fecha de Entrega:</span> <%= new Date(entrega.fecha_entrega).toLocaleString() %></div>
        <div class="info-row"><span class="label">Técnico que Entrega:</span> <%= entrega.tecnico_entrega %></div>
    </div>

    <div class="info-section">
        <h5><i class="fa-solid fa-laptop"></i> DATOS DEL EQUIPO</h5>
        <div class="info-row"><span class="label">Código Informático:</span> <%= equipo.codigo_informatico %></div>
        <div class="info-row"><span class="label">Marca/Modelo:</span> <%= equipo.marca_modelo %></div>
        <div class="info-row"><span class="label">Serie:</span> <%= equipo.serie || 'N/A' %></div>
        <div class="info-row"><span class="label">Estado al Entregar:</span> Reparado</div>
    </div>

    <div class="info-section">
        <h5><i class="fa-solid fa-user-check"></i> QUIÉN RECIBE</h5>
        <div class="info-row"><span class="label">Persona que Retira:</span> <%= entrega.persona_retira %></div>
        <div class="info-row"><span class="label">Documento:</span> <%= entrega.documento_retira || 'No especificado' %></div>
        <div class="info-row"><span class="label">Teléfono:</span> <%= entrega.telefono_retira || 'No especificado' %></div>
    </div>

    <% if (entrega.observaciones) { %>
    <div class="info-section">
        <h5><i class="fa-solid fa-comment"></i> OBSERVACIONES</h5>
        <p><%= entrega.observaciones %></p>
    </div>
    <% } %>

    <!-- Firmas -->
    <div class="firma">
        <div class="firma-linea">
            <hr>
            <p><strong>Firma del Técnico</strong></p>
            <p><%= entrega.tecnico_entrega %></p>
        </div>
        <div class="firma-linea">
            <hr>
            <p><strong>Firma de quien Recibe</strong></p>
            <p><%= entrega.persona_retira %></p>
        </div>
    </div>

    <% if (tipo === 'seguridad') { %>
    <div class="seguridad-nota">
        <i class="fa-solid fa-shield-alt me-2"></i>
        <strong>NOTA PARA SEGURIDAD:</strong> Este comprobante autoriza la salida del equipo 
        <%= equipo.codigo_informatico %> del taller. Favor permitir el retiro.
    </div>
    <% } %>

    <div class="footer" style="margin-top: 20px; text-align: center; font-size: 10px;">
        <p>Este documento es el comprobante de entrega del equipo reparado.</p>
    </div>
</div>

<div style="text-align: center; margin-top: 20px;" class="no-print">
    <button onclick="window.print()"><i class="fa-solid fa-print"></i> Imprimir / Guardar PDF</button>
    <button class="btn-cerrar" onclick="window.location.href='/taller/recepcion'"><i class="fa-solid fa-times"></i> Cerrar</button>
</div>
</body>
</html>