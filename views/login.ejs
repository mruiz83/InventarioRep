<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Acceso al Sistema - ENACAL</title>

  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
  
  <link rel="stylesheet" href="/css/login.css">
</head>
<body>

  <div class="bg-animation"></div>

  <div class="login-container">
    <div class="login-card">
      
      <div class="login-info-side">
        <img src="/img/Logo_ENACAL_2.png" alt="Logo ENACAL">
        <h4 class="fw-bold">Taller de Soporte Técnico</h4>
        <p class="small opacity-75 mt-2">Plataforma de Control de Inventario y Soporte Técnico ENACAL.</p>
        <div class="mt-4 pt-4 border-top border-white border-opacity-25 w-100">
          <i class="fa-solid fa-shield-halved fs-3"></i>
          <div class="small mt-2">Acceso Restringido</div>
        </div>
      </div>

      <div class="login-form-side">
        <h2>Bienvenido</h2>
        <p class="text-muted mb-4">Ingrese sus credenciales para gestionar el taller.</p>

        <% if (messages.error) { %>
          <div class="alert alert-danger py-2 small shadow-sm" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> <%= messages.error %>
          </div>
        <% } %>

        <form method="POST" action="/auth/login">
          <div class="mb-3">
            <label for="usuario" class="form-label">Usuario</label>
            <div class="input-group shadow-sm">
              <span class="input-group-text"><i class="fa-solid fa-user-gear"></i></span>
              <input type="text" class="form-control" id="usuario" name="usuario" placeholder="Nombre de usuario" required autofocus />
            </div>
          </div>

          <div class="mb-4">
            <label for="password" class="form-label">Contraseña</label>
            <div class="input-group shadow-sm">
              <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
              <input type="password" class="form-control" id="password" name="password" placeholder="••••••••" required />
            </div>
          </div>

          <button type="submit" class="btn btn-primary w-100 shadow-sm">
            <i class="fa-solid fa-right-to-bracket me-2"></i> Iniciar Sesión
          </button>
        </form>

        <div class="text-center mt-5">
          <small class="text-muted">© 2026 Dirección de Tecnologías de Información</small>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>