<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<script src="https://cdn.jsdelivr.net/npm/table2excel@1.0.4/dist/table2excel.min.js"></script>

<style>
    .table-xs { font-size: 0.75rem; } 
    .table-xs th { padding: 12px 8px; background-color: #f8f9fa; color: #495057; font-weight: 700; border: none; }
    .table-xs td { padding: 10px 8px; white-space: nowrap; border-bottom: 1px solid #f2f2f2; }
    
    .col-info { 
        max-width: 220px; 
        white-space: normal !important; 
        word-wrap: break-word;
        line-height: 1.2;
    }

    .search-pill {
        border-radius: 50px;
        background-color: #f1f3f4;
        border: 1px solid transparent;
        padding-left: 40px;
        height: 38px;
        transition: all 0.3s;
    }
    .search-pill:focus {
        background-color: #fff;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        border-color: #0d6efd;
    }
</style>

<div class="main-content">
    <header class="top-nav d-flex justify-content-between align-items-center mb-4 px-3">
        <div>
            <h4 class="m-0 text-dark fw-bold text-uppercase" style="letter-spacing: 0.5px;">📦 Stock de Repuestos del Taller</h4>
            <span class="text-muted small">Panel de Control de Inventario Permanente</span>
        </div>
        <div class="user-profile d-flex align-items-center bg-white p-2 rounded-pill shadow-sm border">
            <%- include('partials/user-info') %>
        </div>
    </header>

    <main class="container-fluid">
        <div class="card shadow-sm border-0 mb-3" style="border-radius: 12px;">
            <div class="card-body p-3">
                <div class="row align-items-center">
                    <div class="col-md-7 position-relative">
                        <i class="fa-solid fa-magnifying-glass position-absolute text-muted" style="left: 25px; top: 50%; transform: translateY(-50%); z-index: 5;"></i>
                        <input type="text" id="txt-buscar" class="form-control search-pill" placeholder="Buscar por serie, descripción, marca o aplicación...">
                    </div>
                    <div class="col-md-5 text-end">
                        <button id="btn-exportar" class="btn btn-outline-success btn-sm rounded-pill px-3 fw-bold">
                            <i class="fa-solid fa-file-excel me-1"></i> EXPORTAR
                        </button>
                        <button class="btn btn-primary btn-sm rounded-pill px-4 fw-bold shadow-sm">
                            <i class="fa-solid fa-plus me-1"></i> NUEVO INGRESO
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 bg-white" style="border-radius: 12px; overflow: hidden;">
            <div class="table-responsive">
                <table class="table table-hover align-middle table-xs mb-0" id="tabla-repuestos">
                    <thead>
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Repuesto / Descripción</th>
                            <th>Marca</th>
                            <th>Modelo</th>
                            <th>Capacidad</th>
                            <th>Serie</th>
                            <th>Aplicación</th>
                            <th class="text-center">Stock Actual</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center no-export">Gestión</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (repuestos && repuestos.length > 0) { %>
                            <% repuestos.forEach(item => { 
                                let stock = item.stock_total || 0;
                                let stockColor = stock <= 0 ? 'text-danger' : (stock < 5 ? 'text-warning' : 'text-success');
                            %>
                            <tr class="fila-repuesto">
                                <td class="ps-4 text-muted fw-bold">#<%= item.id_repuestos %></td>
                                <td class="col-info">
                                    <div class="fw-bold text-dark text-uppercase" style="font-size: 0.7rem;"><%= item.nombre %></div>
                                    <div class="text-muted small"><%= item.descripcion %></div>
                                </td>
                                <td><%= item.marca || '---' %></td>
                                <td><%= item.modelo || '---' %></td>
                                <td><%= item.capacidad || 'N/A' %></td>
                                <td class="fw-mono text-primary"><%= item.serie || 'S/N' %></td>
                                <td><span class="badge bg-light text-dark border text-uppercase" style="font-size: 0.65rem;"><%= item.aplicacion %></span></td>
                                
                                <td class="text-center">
                                    <span class="fs-6 fw-bold <%= stockColor %>"><%= stock %></span>
                                </td>

                                <td class="text-center">
                                    <span class="badge rounded-pill <%= item.estado === 'Nuevo' ? 'bg-success' : 'bg-warning text-dark' %>" style="font-size: 0.65rem; padding: 5px 10px;">
                                        <%= item.estado %>
                                    </span>
                                </td>
                                <td class="text-center no-export">
                                    <button class="btn btn-sm btn-outline-primary border-0 rounded-circle" title="Editar o Ver Detalles">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </button>
                                </td>
                            </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const inputBuscar = document.getElementById('txt-buscar');
    const filas = document.querySelectorAll('.fila-repuesto');

    // Buscador en tiempo real optimizado
    inputBuscar.addEventListener('keyup', function() {
        const busqueda = this.value.toLowerCase();
        filas.forEach(fila => {
            const textoFila = fila.innerText.toLowerCase();
            fila.style.display = textoFila.includes(busqueda) ? '' : 'none';
        });
    });

    // Para exportar a excel
    document.getElementById('btn-exportar').addEventListener('click', function() {
        const table2excel = new Table2Excel();
        table2excel.export(document.querySelectorAll("#tabla-repuestos"), {
            name: "Inventario_Auditado_Taller.xlsx",
            sheet: { name: "Stock_Actual" },
            exclude_cols: [9] 
        });
    });
});
</script>

<%- include('partials/footer') %>
