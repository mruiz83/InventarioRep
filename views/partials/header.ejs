<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>InventarioRep - ENACAL</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- LIBRERÍA PARA GRÁFICOS (Chart.js) -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <style>
    :root {
      --sidebar-width: 280px;
      --primary-color: #0e446b;
      --accent-color: #f0ee91;
      --bg-body: #f8fafc;
      --card-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    }

    body { 
      font-family: 'Inter', sans-serif; 
      background-color: var(--bg-body); 
      margin: 0; 
      display: flex;
    }

    /* Sidebar con Degradado */
    .sidebar {
    width: 260px; /* O el ancho que tengas */
    background: #003366; /* Ajusta a tu color azul institucional */
    position: fixed;
    left: 0;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
}

.sidebar-menu {
    flex-grow: 1;
    overflow-y: auto;
    padding-bottom: 20px; /* Espacio al final para que no pegue el último link */
}

/* Esto quita el scroll horizontal si los links son muy largos */
.nav-link {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
    

    .nav-link {
      color: rgba(255,255,255,0.7);
      padding: 14px 25px;
      margin: 4px 15px;
      border-radius: 12px;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      text-decoration: none;
    }

    .nav-link:hover, .nav-link.active {
      background: rgba(255,255,255,0.1);
      color: var(--accent-color);
      transform: translateX(5px);
    }

    /* Contenido Principal */
    .main-content {
      margin-left: var(--sidebar-width);
      flex: 1;
      padding: 30px;
    }

    .glass-card {
      background: white;
      border: none;
      border-radius: 16px;
      box-shadow: var(--card-shadow);
      transition: transform 0.3s ease;
    }

    .glass-card:hover { transform: translateY(-5px); }

    .top-nav {
      background: rgba(255,255,255,0.8);
      backdrop-filter: blur(10px);
      border-radius: 16px;
      padding: 15px 25px;
      margin-bottom: 30px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

  

    /* Estilos para móviles */
@media (max-width: 768px) {
    
    /* 1. Escondemos el sidebar lateralmente */
    .sidebar {
        position: fixed;
        left: -250px; /* Ancho del sidebar para que quede oculto */
        width: 250px;
        height: 100vh;
        transition: all 0.3s ease-in-out;
        z-index: 1000;
        background: #003366; /* Su color de fondo */
    }

    /* 2. Ocultamos la imagen por defecto en el estado "minimizado" */
    .sidebar-logo {
        display: none;
    }

    /* 3. Cuando el menú se activa (clase .open que pondremos con JS) */
    .sidebar.open {
        left: 0; /* Aparece el sidebar */
    }

    /* 4. La imagen se muestra como miniatura cuando el menú está abierto */
    .sidebar.open .sidebar-logo {
        display: block;
        width: 45px;      /* Tamaño miniatura */
        height: 45px;
        margin: 50px auto 10px; /* Espacio para el botón y centrado */
        border-radius: 50%;
        object-fit: cover;
    }

    /* Estilo del botón hamburguesa */
    .hamburger-btn {
        display: block;
        position: fixed;
        top: 10px;
        left: 10px;
        z-index: 1100;
        padding: 10px;
        background: #007bff;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        pointer-events: auto !important; /* Asegura que el botón siempre sea clicable */
        isolation: isolate; /* Crea un contexto de aislamiento para que el z-index sea absoluto */
    }

    /* Ajustar el contenido principal para ocupar toda la pantalla en móviles */
    .main-content {
        margin-left: 0;
    }
}

/* En escritorio ocultamos el botón hamburguesa */
@media (min-width: 769px) {
    .hamburger-btn {
        display: none;
    }
}

  </style>
</head>
<body>
