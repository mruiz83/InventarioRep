<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<div class="main-content">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="m-0 text-secondary fw-bold">
                <i class="fa-solid fa-clock-rotate-left me-2 text-primary"></i>Historial de Órdenes
            </h4>
            <p class="text-muted small mb-0">Registro de órdenes completadas por técnico.</p>
        </div>
        <div>
            <a href="/dashboard" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="fa-solid fa-arrow-left me-2"></i>Volver al panel
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th># Orden</th>
                        <th>Tipo</th>
                        <th>Equipo</th>
                        <th>Fecha cierre</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (ordenes.length > 0) { %>
                        <% ordenes.forEach(orden => { %>
                            <tr>
                                <td><strong><%= orden.numero_orden %></strong></td>
                                <td><span class="badge bg-info text-dark"><%= orden.tipo_orden %></span></td>
                                <td><%= orden.codigo_informatico || 'Sin equipo' %></td>
                                <td><%= orden.fecha_cierre ? new Date(orden.fecha_cierre).toLocaleDateString() : '-' %></td>
                                <td><span class="badge bg-success">Completada</span></td>
                                <td class="text-end">
                                    <a href="/ordenes/<%= orden.id_orden %>" class="btn btn-sm btn-primary rounded-pill me-2">
                                        <i class="fa-solid fa-eye me-1"></i>Ver
                                    </a>
                                    <a href="/ordenes/<%= orden.id_orden %>/imprimir" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill">
                                        <i class="fa-solid fa-print me-1"></i>Imprimir
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="fa-solid fa-inbox fa-2x mb-2"></i>
                                No hay órdenes completadas todavía.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
