<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<div class="main-content">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="m-0 text-secondary fw-bold">
                <% if (tipo === 'remota') { %>
                    <i class="fa-solid fa-laptop me-2 text-primary"></i>Órdenes Remotas
                <% } else { %>
                    <i class="fa-solid fa-building me-2 text-primary"></i>Órdenes Fuera del Taller
                <% } %>
            </h4>
            <p class="text-muted small mb-0">Listado de órdenes creadas y pendientes para atención.</p>
        </div>
        <div>
            <a href="/ordenes/fuera/nueva?tipo=<%= tipo %>" class="btn btn-primary rounded-pill px-4">
                <i class="fa-solid fa-plus me-2"></i>Crear Nueva Orden
            </a>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm text-center bg-warning bg-opacity-10">
                <div class="card-body py-3">
                    <h5 class="text-warning mb-0"><%= pendientes %></h5>
                    <small class="text-muted">Pendientes</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm text-center bg-info bg-opacity-10">
                <div class="card-body py-3">
                    <h5 class="text-info mb-0"><%= enProceso %></h5>
                    <small class="text-muted">En Proceso</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm text-center bg-success bg-opacity-10">
                <div class="card-body py-3">
                    <h5 class="text-success mb-0"><%= completadas %></h5>
                    <small class="text-muted">Completadas</small>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <div>
                <h6 class="fw-bold mb-0">Órdenes</h6>
                <small class="text-muted">Total: <%= ordenes.length %></small>
            </div>
            <div>
                <a href="/dashboard" class="btn btn-outline-secondary btn-sm rounded-pill">
                    <i class="fa-solid fa-arrow-left me-1"></i>Volver al panel
                </a>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th># Orden</th>
                        <th>Equipo</th>
                        <th>Técnico</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (ordenes.length > 0) { %>
                        <% ordenes.forEach(orden => { %>
                            <tr>
                                <td><strong><%= orden.numero_orden %></strong></td>
                                <td>
                                    <div><%= orden.codigo_informatico || 'Sin equipo' %></div>
                                    <small class="text-muted"><%= orden.marca_modelo || 'Sin modelo' %></small>
                                </td>
                                <td><%= orden.tecnico_nombre || 'Sin técnico' %></td>
                                <td><%= orden.fecha_apertura ? new Date(orden.fecha_apertura).toLocaleDateString() : '-' %></td>
                                <td>
                                    <% if (orden.estado === 'Pendiente') { %>
                                        <span class="badge bg-warning text-dark">Pendiente</span>
                                    <% } else if (orden.estado === 'En Proceso') { %>
                                        <span class="badge bg-info">En Proceso</span>
                                    <% } else { %>
                                        <span class="badge bg-success">Completada</span>
                                    <% } %>
                                </td>
                                <td class="text-end">
                                    <a href="/ordenes/<%= orden.id_orden %>" class="btn btn-sm btn-primary rounded-pill">
                                        <i class="fa-solid fa-eye me-1"></i>Ver
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="fa-solid fa-inbox fa-2x mb-2"></i>
                                <div>No hay órdenes registradas aún.</div>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
